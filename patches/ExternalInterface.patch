+				ImageDataUtil::Resize (srcImage, destBuffer, newWidth, newHeight);
+
+				imageBuffer.data = destBuffer->data;
+				destBuffer->data = 0;
+
+				imageBuffer.width = newWidth;
+				imageBuffer.height = newHeight;
+
+				delete destBuffer;
