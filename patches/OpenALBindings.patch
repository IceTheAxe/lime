+	void lime_alc_capture_samples (value device, value buffer, int samples) {
+		Bytes bytes (buffer);
+		if (bytes.b && bytes.length > 0 && samples > 0) {
+			alcCaptureSamples ((ALCdevice*)val_data (device), bytes.b, samples);
+		}
+	}
