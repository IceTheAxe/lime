+			{
+				resolved += 1;
+				if (resolved == futures.length)
+				{
+					promise.complete(futures);
+				}
+			});
+			future.onError(function(error)
+			{
+				resolved += 1;
+				if (resolved == futures.length)
+				{
+					promise.complete(futures);
+				}
+			});
