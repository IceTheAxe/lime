+		else if (Browser.window.matchMedia('(prefers-color-scheme: light)').matches)
+		{
+			return Theme.LIGHT;
+		}
+
+		return Theme.UNKNOWN;
+		#elseif (lime_cffi && !macro)
+		return cast NativeCFFI.lime_system_get_theme();
+		#else
+		return Theme.UNKNOWN;
+		#end
+	}
